    {
      "@type": "Article",
      "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-australian-artists#article",
      "description": "Access free resources and low- or no-cost legal advice for Australian artists and arts organisations.",
      "mainEntityOfPage": {

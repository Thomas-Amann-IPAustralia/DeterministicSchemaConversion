    {
      "@type": "Article",
      "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-those-involved-australian-creative-industries#article",
      "description": "Null",
      "mainEntityOfPage": {
        "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-those-involved-australian-creative-industries#webpage"
      },
      "inLanguage": "en-AU",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "publisher": {
        "@id": "https://www.ipaustralia.gov.au/#organization"
      },
      "author": {
        "@id": "https://www.ipaustralia.gov.au/#organization"
      },
      "headline": "Access help tailored to those involved in Australian creative industries",
      "articleBody": "The Australian Copyright Council (ACC) is an independent, not-for-profit Community Legal Service (CLS). ACC promotes the understanding of copyright law and its application to all art forms.\n\nYou can access ACC's comprehensive, free fact sheet collection  for an overview of copyright law and rights in relation to your circumstances. You can also access information about services ACC has available on their website.",
      "dateModified": "2026-02-23",
      "hasPart": [
        {
          "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-those-involved-australian-creative-industries#faq"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-those-involved-australian-creative-industries#faq",
      "inLanguage": "en-AU",
      "isPartOf": {
        "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-those-involved-australian-creative-industries#webpage"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-those-involved-australian-creative-industries#faq-q1",
          "name": "What is offered?",
          "acceptedAnswer": {
            "@type": "Answer",
            "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-those-involved-australian-creative-industries#faq-q1-a",
            "text": "Accessible practical information, education  and training  on Australian copyright law for creators and consumers.\n No-cost written legal advice  (by email) to eligible persons (predominately those who work in creative industries)."
          }
        },
        {
          "@type": "Question",
          "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-those-involved-australian-creative-industries#faq-q2",
          "name": "What services are not offered?",
          "acceptedAnswer": {
            "@type": "Answer",
            "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-those-involved-australian-creative-industries#faq-q2-a",
            "text": "Note that ACC's legal advice service does not extend to:\n\n advice to businesses\n formal legal representation\n drafting documents or letters on behalf of the client\n providing a general review of contracts, policies, agreements or other materials\n- engaging in negotiations, litigation or appearing in court on the client's behalf."
          }
        },
        {
          "@type": "Question",
          "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-those-involved-australian-creative-industries#faq-q3",
          "name": "What are the possible outcomes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-those-involved-australian-creative-industries#faq-q3-a",
            "text": "You may gain a better understanding various aspects related to copyright, including information about copyright law and possible enforcement options.\n You may gain a better understanding your rights and decide what to do next in your situation.\n- ACC may direct you to other resources to assist with your particular circumstances, including alternative dispute resolution service or legal advice."
          }
        },
        {
          "@type": "Question",
          "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-those-involved-australian-creative-industries#faq-q4",
          "name": "What might the costs be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-those-involved-australian-creative-industries#faq-q4-a",
            "text": "Accessing ACC's online fact sheets  and submitting a query to the ACC's legal advice service  is no-cost.\n ACC also offers books for sale on various topics relevant to copyright.\n- ACC-facilitated training is available (attendance fees may apply)."
          }
        },
        {
          "@type": "Question",
          "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-those-involved-australian-creative-industries#faq-q5",
          "name": "How much time might be involved?",
          "acceptedAnswer": {
            "@type": "Answer",
            "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-those-involved-australian-creative-industries#faq-q5-a",
            "text": "ACC's online resources can be accessed at any time on their website. \n\nThe response time for the ACC's legal advice service  is generally between 5-10 working days. However, there may sometimes be delays during periods of heavy demand."
          }
        },
        {
          "@type": "Question",
          "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-those-involved-australian-creative-industries#faq-q6",
          "name": "Who can use this?",
          "acceptedAnswer": {
            "@type": "Answer",
            "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-those-involved-australian-creative-industries#faq-q6-a",
            "text": "Creators and consumers of copyright material, including:\n\n creators working in any medium\n creator industry bodies\n- staff of:\n + museums\n + libraries\n + galleries\n + education institutions."
          }
        },
        {
          "@type": "Question",
          "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-those-involved-australian-creative-industries#faq-q7",
          "name": "What do you need to proceed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "@id": "https://ipfirstresponse.ipaustralia.gov.au/options/access-help-tailored-those-involved-australian-creative-industries#faq-q7-a",
            "text": "ACC's online resources can be accessed at any time on its website. \n\nTo submit a request for advice, you can click the relevant blue link on ACC's legal advice webpage. You will be prompted to log into ACC's system (if you do not already have an account on ACC's website, you will be prompted to create one)."
          }
        }
      ]
    },
